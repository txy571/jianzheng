[
  {"id":1,"text":"生产资料的最终所有权应当由全社会的劳动者共同掌握。","weights":{"econ":2,"diplomatic":0,"state":1,"society":0,"tech":0}},
  {"id":2,"text":"自由市场的价格机制在分配资源时，其效率远超任何形式的中央计划。","weights":{"econ":-2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":3,"text":"政府应当通过实施极为严厉的累进税制来彻底消除社会中的财富鸿沟。","weights":{"econ":2,"diplomatic":0,"state":1,"society":0,"tech":0}},
  {"id":4,"text":"大幅降低企业的税收负担是刺激经济活力、创造更多就业岗位的最佳途径。","weights":{"econ":-2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":5,"text":"为了应对自动化和人工智能造成的结构性失业，实施全民基本收入（UBI）是绝对必要的。","weights":{"econ":2,"diplomatic":0,"state":0,"society":-1,"tech":-1}},
  {"id":6,"text":"那些不受地理限制的跨国巨头公司在本质上损害了全球底层民众的利益。","weights":{"econ":1,"diplomatic":-1,"state":0,"society":0,"tech":0}},
  {"id":7,"text":"医疗、教育等所有公共服务都应当被完全私有化，交由市场竞争来提升其质量。","weights":{"econ":-2,"diplomatic":0,"state":-1,"society":0,"tech":0}},
  {"id":8,"text":"强大的劳工工会是保护普通工人免受资本家无情剥削的唯一屏障。","weights":{"econ":2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":9,"text":"在一个真正公正的经济体系中，不应该允许\"亿万富翁\"这种群体的存在。","weights":{"econ":2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":10,"text":"个人有权保留其劳动赚取的每一分财富，政府征收所得税本质上是一种合法的盗窃。","weights":{"econ":-2,"diplomatic":0,"state":-1,"society":0,"tech":0}},
  {"id":11,"text":"法定的最低工资标准实际上扭曲了劳动力市场，导致了更高的失业率，应予废除。","weights":{"econ":-2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":12,"text":"诸如供水、电力、公共交通等基础生命线行业必须由国家垄断运营，绝不能追求利润。","weights":{"econ":2,"diplomatic":0,"state":1,"society":0,"tech":0}},
  {"id":13,"text":"征收高额的遗产继承税，实际上是在惩罚那些努力为子孙后代积累财富的家庭。","weights":{"econ":-1,"diplomatic":0,"state":0,"society":1,"tech":0}},
  {"id":14,"text":"对外贸易的保护主义政策（如高关税）会严重破坏全球供应链，损害长期经济繁荣。","weights":{"econ":-1,"diplomatic":-1,"state":0,"society":0,"tech":0}},
  {"id":15,"text":"土地是大自然赋予全人类的资源，任何人或机构都不应拥有其绝对的私人产权。","weights":{"econ":2,"diplomatic":0,"state":0,"society":-1,"tech":0}},
  {"id":16,"text":"解除政府对金融市场和银行业的严苛监管，是刺激大规模金融创新的先决条件。","weights":{"econ":-2,"diplomatic":0,"state":-1,"society":0,"tech":0}},
  {"id":17,"text":"虽然市场经济会产生短期不平等，但随着时间的推移，市场本身的扩张最终会自动消灭贫困。","weights":{"econ":-1,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":18,"text":"企业在法律框架内实现股东利润的最大化，是商业实体存在唯一且合理的道德目的。","weights":{"econ":-2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":19,"text":"获得体面的住房是一项基本的人权，房屋绝不应当沦为金融投机者炒作的商品。","weights":{"econ":2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":20,"text":"现行的知识产权法（专利、版权）已经变异成了资本垄断技术的工具，严重阻碍了人类进步。","weights":{"econ":1,"diplomatic":0,"state":0,"society":-1,"tech":-1}},
  {"id":21,"text":"只有消除所有国际贸易壁垒，世界各国才能基于比较优势实现共同利益的最大化。","weights":{"econ":-1,"diplomatic":-2,"state":0,"society":0,"tech":0}},
  {"id":22,"text":"政府试图干预和微调经济运行周期的行为，最终带来的灾难往往多于带来的好处。","weights":{"econ":-1,"diplomatic":0,"state":-1,"society":0,"tech":0}},
  {"id":23,"text":"在极端物资匮乏的情况下，为了保障所有人的生存，国家实施全面配给制是合理且高尚的。","weights":{"econ":2,"diplomatic":0,"state":1,"society":0,"tech":0}},
  {"id":24,"text":"在制定国家战略时，实现GDP的高速增长应当被置于环境保护或减少碳排放的考量之上。","weights":{"econ":-1,"diplomatic":0,"state":0,"society":1,"tech":1}},
  {"id":25,"text":"从\"各尽所能，按劳分配\"最终走向\"各尽所能，按需分配\"，是人类社会经济进化的终极归宿。","weights":{"econ":2,"diplomatic":0,"state":0,"society":-1,"tech":0}},
  {"id":26,"text":"无论是从历史贡献还是从文明底蕴来看，我的国家在本质上都优于世界上绝大多数国家。","weights":{"econ":0,"diplomatic":2,"state":1,"society":1,"tech":0}},
  {"id":27,"text":"联合国、世界贸易组织等国际机构在很大程度上是对各个主权国家内政的非法干涉。","weights":{"econ":0,"diplomatic":2,"state":1,"society":0,"tech":0}},
  {"id":28,"text":"随着人类文明的发展，我们最终应当打破所有国界，建立一个统一的地球联邦政府。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-1,"tech":0}},
  {"id":29,"text":"面对逃避战争或饥荒的国际难民，我们有不可推卸的道德义务向他们无条件敞开国门。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-1,"tech":0}},
  {"id":30,"text":"拥有一支拥有压倒性优势的强大武装部队，是在这个丛林世界中维持国家生存的唯一保障。","weights":{"econ":0,"diplomatic":2,"state":1,"society":0,"tech":1}},
  {"id":31,"text":"在处理国际争端时，即使面临重大挑衅，冗长的外交协商也永远优于任何形式的军事武装干预。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":0,"tech":0}},
  {"id":32,"text":"国家应当毫不犹豫地对外国进口产品征收惩罚性关税，哪怕这会引发贸易战，也必须保护本土制造业。","weights":{"econ":1,"diplomatic":2,"state":0,"society":0,"tech":0}},
  {"id":33,"text":"所谓的\"边界线\"不过是掌权者为了在地图上划分统治范围而虚构的线条，它们终将被历史淘汰。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-1,"tech":0}},
  {"id":34,"text":"在我们自己国家内部还有人挨饿受穷的时候，向其他国家提供国际援助是对本国纳税人的巨大背叛。","weights":{"econ":-1,"diplomatic":2,"state":0,"society":0,"tech":0}},
  {"id":35,"text":"国际法只有在符合我们国家战略利益的时候才有遵守的价值，否则我们完全有权利无视它。","weights":{"econ":0,"diplomatic":2,"state":1,"society":1,"tech":0}},
  {"id":36,"text":"保护整个地球的生态环境免遭破坏，其重要性远远超过维护任何单一国家内部特定工业的经济利益。","weights":{"econ":0,"diplomatic":-1,"state":0,"society":-1,"tech":0}},
  {"id":37,"text":"如果一个国家处于独裁压迫之下，民主国家有责任也有义务通过各种手段向其输出民主与自由的价值观。","weights":{"econ":0,"diplomatic":-1,"state":-1,"society":-1,"tech":0}},
  {"id":38,"text":"我们应当大幅度削减庞大的军事预算，将这些资金全部转移到国内的医疗、教育和基础设施建设上。","weights":{"econ":1,"diplomatic":-2,"state":0,"society":0,"tech":0}},
  {"id":39,"text":"任何选择来到我国的移民，都必须彻底放弃他们原有的习俗，完全同化并融入我们国家的主流传统文化。","weights":{"econ":0,"diplomatic":2,"state":1,"society":2,"tech":0}},
  {"id":40,"text":"一个国家内部存在多种截然不同的文化并允许其独立发展（即多元文化主义），是国家的优势而非劣势。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-2,"tech":0}},
  {"id":41,"text":"狂热的爱国主义本质上是一种极其危险的情感，它总是被政客利用来煽动民众对外的非理性仇恨。","weights":{"econ":0,"diplomatic":-2,"state":0,"society":-1,"tech":0}},
  {"id":42,"text":"在今天这个经济、技术、信息高度全球化的时代，传统的\"民族国家\"概念已经彻底过时了。","weights":{"econ":0,"diplomatic":-2,"state":0,"society":-1,"tech":-1}},
  {"id":43,"text":"当一个国家面临资源枯竭、生存空间受限时，向外进行军事扩张或争取势力范围在历史角度上是合理的。","weights":{"econ":1,"diplomatic":2,"state":1,"society":1,"tech":0}},
  {"id":44,"text":"当某个国家内部正在发生严重的人道主义危机（如种族灭绝）时，国际社会有权无视其主权进行武力干预。","weights":{"econ":0,"diplomatic":-1,"state":-1,"society":0,"tech":0}},
  {"id":45,"text":"从根本上讲，我国一位普通公民的生命权和利益，必然比地球另一端外国人的生命更具优先价值。","weights":{"econ":0,"diplomatic":2,"state":0,"society":0,"tech":0}},
  {"id":46,"text":"历史证明，国家之间的和平协议往往只是一纸空文，最终能够一劳永逸解决国际冲突的手段只有战争。","weights":{"econ":0,"diplomatic":2,"state":1,"society":0,"tech":0}},
  {"id":47,"text":"世界各国应当放弃自己独立的货币政策，最终统一使用一种全球性的法定货币以消除汇率剥削。","weights":{"econ":-1,"diplomatic":-2,"state":0,"society":0,"tech":0}},
  {"id":48,"text":"维护本国主要民族的人口比例、血统和文化纯洁性，对于保持国家内部的长期稳定和凝聚力至关重要。","weights":{"econ":0,"diplomatic":2,"state":1,"society":2,"tech":0}},
  {"id":49,"text":"签署复杂的国际防卫同盟和军事互助条约，只会将我们不必要地拖入他国的战争泥潭之中。","weights":{"econ":0,"diplomatic":1,"state":0,"society":0,"tech":0}},
  {"id":50,"text":"科学突破和尖端技术的分享不应当受制于国家的意识形态对抗，全人类应当毫无保留地共享科学成果。","weights":{"econ":0,"diplomatic":-2,"state":0,"society":-1,"tech":-2}},
  {"id":51,"text":"相比于效率低下、相互扯皮的民主议会选举，一个强有力且不受制约的领导人能更有效率地治理国家。","weights":{"econ":0,"diplomatic":0,"state":2,"society":1,"tech":0}},
  {"id":52,"text":"只要是两个成年人之间完全自愿的私人行为（不论涉及什么内容），国家机器就没有任何权力进行干涉。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":53,"text":"为了在现代社会有效防范恐怖袭击和重大犯罪，政府对公民的网络和通讯进行无差别的大规模监听是必要的。","weights":{"econ":0,"diplomatic":0,"state":2,"society":0,"tech":2}},
  {"id":54,"text":"所有种类的毒品（包括硬性毒品）的个人吸食行为都应当被去罪化甚至合法化，因为这是个人身体的自主权。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":-1,"tech":0}},
  {"id":55,"text":"当某些极端的政治言论严重威胁到国家的根本制度和公共安全时，政府对其进行严格的审查和封杀是正当的。","weights":{"econ":0,"diplomatic":1,"state":2,"society":1,"tech":1}},
  {"id":56,"text":"允许普通公民广泛合法地持有枪支，不仅是个人自卫的需要，更是人民抵抗未来可能出现的暴政的最后防线。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":57,"text":"我们应当赋予一线执法人员（如警察）更广泛的使用武力和搜查的权限，因为目前的法律过于保护嫌疑人了。","weights":{"econ":0,"diplomatic":0,"state":2,"society":1,"tech":0}},
  {"id":58,"text":"个人的自由边界只能是\"不直接侵害他人的身体或财产\"，除此之外，任何形式的自由都应当是绝对不受限制的。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":59,"text":"对于犯下叛国罪、严重连环杀人案或重大恐怖主义罪行的人，必须适用死刑以彰显正义并实现物理消除。","weights":{"econ":0,"diplomatic":0,"state":2,"society":1,"tech":0}},
  {"id":60,"text":"像爱德华·斯诺登这样的内部\"吹哨人\"，因揭露政府非法的全民监控计划而泄露国家机密，应当被视为英雄而非叛徒。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":-2}},
  {"id":61,"text":"犯罪率居高不下的根本原因在于刑罚不够严厉，我们需要更残忍的惩罚机制（如肉刑或强制苦役）来震慑潜在罪犯。","weights":{"econ":0,"diplomatic":0,"state":2,"society":2,"tech":0}},
  {"id":62,"text":"当一个政府变得长期压迫且无法通过和平手段改良时，民众拥有使用武装暴力彻底推翻它的天然权利。","weights":{"econ":-1,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":63,"text":"当国家面临生存危机或外部战争威胁时，强制实施全民义务兵役制是每一个国民都必须无条件服从的神圣义务。","weights":{"econ":0,"diplomatic":1,"state":2,"society":1,"tech":0}},
  {"id":64,"text":"很多人害怕无政府状态，但真正的无政府状态并不意味着混乱与血腥，而是意味着人类终于摆脱枷锁，获得了真正的自由。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":65,"text":"国家机器（包含军队、法庭、监狱）的存在本身，就是对人类天然权利的一种制度化、合法化的强制侵犯。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":66,"text":"建立在等级和权威之上的社会秩序，是人类文明存在的最根本基础；没有秩序，任何所谓的个人自由都只是幻影。","weights":{"econ":0,"diplomatic":0,"state":2,"society":1,"tech":0}},
  {"id":67,"text":"无论以何种崇高的名义（如保护未成年人、维护道德），所有形式的国家出版物审查制度都应当遭到坚决的抵制。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":-1}},
  {"id":68,"text":"\"无罪推定\"是一项不可动摇的底线原则：在法庭给出确凿且无可辩驳的证据证明其有罪之前，任何被控告的人都必须被完全视为无罪。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":69,"text":"如果情况紧急且有合理怀疑，应该允许警察在没有取得法官搜查令的情况下，直接破门搜查嫌疑分子的住所。","weights":{"econ":0,"diplomatic":0,"state":2,"society":0,"tech":0}},
  {"id":70,"text":"像赌博、卖淫、自残等所谓的\"受害者缺席的犯罪\"（Victimless crimes），只要不强迫他人，就不应当被定义为犯罪。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":71,"text":"在面临严重的公共危机（如传染病大流行、暴乱）时，为了多数人的集体利益和生存，个人的隐私权必须被强制搁置。","weights":{"econ":0,"diplomatic":0,"state":2,"society":0,"tech":1}},
  {"id":72,"text":"多党制不可避免地导致社会撕裂和政策短视，只有一党制或由精英组成的威权政府，才能心无旁骛地执行长远的国家战略。","weights":{"econ":0,"diplomatic":0,"state":2,"society":1,"tech":0}},
  {"id":73,"text":"如果某项法律不仅不公正，而且明显违反了基本的人类良知，公民不仅有权拒绝遵守它，更有责任公开对抗它。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":0}},
  {"id":74,"text":"监狱系统的首要甚至唯一目的应当是惩罚罪犯并将其与社会隔离，所谓的\"教化\"或\"劳动改造\"是对纳税人资金的浪费。","weights":{"econ":0,"diplomatic":0,"state":1,"society":1,"tech":0}},
  {"id":75,"text":"社交媒体上充斥着虚假信息和敌对宣传，政府必须直接接管或强力控制互联网媒体，以确保民众获取到的是\"正确的信息\"。","weights":{"econ":0,"diplomatic":1,"state":2,"society":1,"tech":2}},
  {"id":76,"text":"古老的宗教信仰和历史传承下来的传统价值观，应当继续作为我们现代社会道德体系的不可动摇的基石。","weights":{"econ":0,"diplomatic":0,"state":1,"society":2,"tech":0}},
  {"id":77,"text":"同性恋伴侣在法律层面上的地位应当与异性恋伴侣完全一致，包括拥有绝对平等的合法婚姻权和共同收养子女的权利。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":0}},
  {"id":78,"text":"除极少数极端特殊情况（如母亲生命受到直接威胁）外，堕胎在任何阶段都应当被视为谋杀，并被法律严格禁止。","weights":{"econ":0,"diplomatic":0,"state":1,"society":2,"tech":0}},
  {"id":79,"text":"试图通过基因编辑、神经接口等技术手段来\"升级\"或改变人类自身的生物学属性是极其危险的，也是对造物主的亵渎，必须全面禁止。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":2}},
  {"id":80,"text":"由一位父亲、一位母亲及亲生子女组成的传统\"核心家庭\"，是维持社会稳定发展的唯一健康细胞，必须受到国家的特殊保护。","weights":{"econ":0,"diplomatic":0,"state":1,"society":2,"tech":0}},
  {"id":81,"text":"所谓的\"性别角色\"在很大程度上是后天社会建构的产物，而不是完全由天生的生物学解剖特征所决定的死板规律。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-2,"tech":0}},
  {"id":82,"text":"现代社会的发展步伐过于激进，我们抛弃、解构祖先留下的历史传统和文化仪式的速度实在是太快了。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":1}},
  {"id":83,"text":"即使会导致短期内大量工人失业和重工业的彻底衰退，为了保护地球生态系统，激进的环保政策也是绝对必要的。","weights":{"econ":1,"diplomatic":0,"state":0,"society":-1,"tech":0}},
  {"id":84,"text":"人工智能的加速发展虽然存在风险，但它最终将把人类从苦役中彻底解放出来，我们应当全力支持甚至加速科技奇点的到来。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-2,"tech":-2}},
  {"id":85,"text":"虽然现代社会宣扬男女平等，但女性在社会中更天然、更主要的角色，依然应当是回归家庭，专注于抚育后代和维持内部和睦。","weights":{"econ":0,"diplomatic":0,"state":1,"society":2,"tech":0}},
  {"id":86,"text":"跨性别者寻求通过医疗手段（如激素治疗、性别重置手术）改变自己身份认同的行为，应当得到全社会的绝对包容和医疗系统的全力支持。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":-1}},
  {"id":87,"text":"科学技术是对抗自然规律的有力武器，人类的使命就是要不断超越自身脆弱的生物学极限，掌控自己的进化方向。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-2,"tech":-2}},
  {"id":88,"text":"仔细观察当前的许多所谓的\"现代艺术\"和无底线的流行文化，它们不过是人类社会精神萎靡、道德堕落的象征而已。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":0}},
  {"id":89,"text":"每一个心智健全的成年人，都应当拥有掌控自己死亡时间的绝对权利，安乐死（协助自杀）必须是一项合法的基本人权。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":-1}},
  {"id":90,"text":"无论公立还是私立，学校都应该鼓励甚至组织学生每天进行祈祷，或者至少举行向传统神明、民族英烈致敬的仪式。","weights":{"econ":0,"diplomatic":1,"state":1,"society":2,"tech":0}},
  {"id":91,"text":"越来越多国家对轻度毒品实行去罪化，这并不是社会的退步，而是社会从死板的道德惩罚向现代医疗康复观念转变的文明体现。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":0}},
  {"id":92,"text":"那些认为没有上帝或者没有宗教信仰，人类也能自发维持崇高道德的观点是完全错误的。没有超验的敬畏，道德必然会迅速崩塌。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":0}},
  {"id":93,"text":"现代主流社会拥有不可推卸的责任和义务，去通过系统性的补偿政策（如平权法案或直接的经济赔偿），来弥补历史上对某些少数群体造成的压迫。","weights":{"econ":1,"diplomatic":0,"state":0,"society":-2,"tech":0}},
  {"id":94,"text":"我们的学术界、媒体和整个社会，如今已经被极端的\"政治正确\"所绑架，导致人们甚至不敢自由地说出显而易见的事实常识。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":0}},
  {"id":95,"text":"传统宗教节日日益被剥离了其神圣的内核，变成单纯的商业打折季和世俗狂欢日，这是对我们深层文化根基的严重破坏。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":0}},
  {"id":96,"text":"追求个人的生物学永生，或是将人类意识上传到数字网络中（即超人类主义的愿景），这并不是科幻妄想，而是人类文明进化的正确且唯一的方向。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-2,"tech":-2}},
  {"id":97,"text":"严格听从长辈的教诲、无条件服从权威的指示，不仅是维持社会运作的齿轮，更是当代青少年最应当培养的美德。","weights":{"econ":0,"diplomatic":0,"state":1,"society":2,"tech":0}},
  {"id":98,"text":"任何建立在迷信、神谕或不可证伪的教条之上的制度都必须被废除，未来的社会构建必须且只能由冰冷的理性、严谨的逻辑和实证科学来主导。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":-2}},
  {"id":99,"text":"所谓的\"社会进步\"，其本质就意味着一代又一代人不断地去质疑、颠覆和打破前人定下的旧有规范和禁忌。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-2,"tech":0}},
  {"id":100,"text":"坦白地说，我经常觉得现代社会的复杂和堕落令人窒息，我希望未来的社会风貌能够倒退回去，与几百年前的社会保持本质上的一致。","weights":{"econ":0,"diplomatic":1,"state":1,"society":2,"tech":2}},
  {"id":101,"text":"面对暴力示威者，政府应当止暴制乱恢复秩序。","weights":{"econ":0,"diplomatic":0,"state":2,"society":1,"tech":0}},
  {"id":102,"text":"每个人在互联网上匿名的权利都应当得到保证。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":-2}},
  {"id":103,"text":"挑战国家主权和社会稳定的言论，不属于言论自由的范畴。","weights":{"econ":0,"diplomatic":1,"state":2,"society":1,"tech":1}},
  {"id":104,"text":"在房屋征收拆迁过程中，政府有权拒绝过高的拆迁补偿要求。","weights":{"econ":1,"diplomatic":0,"state":1,"society":0,"tech":0}},
  {"id":105,"text":"个人主义思想的流行让社会陷入原子化的危机。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":0}},
  {"id":106,"text":"废除以警察和军队，以私人安保公司和民兵组织来维持治安。","weights":{"econ":-1,"diplomatic":0,"state":-2,"society":-1,"tech":0}},
  {"id":107,"text":"罢工是一种懒惰自私的行为，给他人造成了麻烦。","weights":{"econ":-2,"diplomatic":0,"state":1,"society":1,"tech":0}},
  {"id":108,"text":"色情内容败坏社会风气，有必要进行打击。","weights":{"econ":0,"diplomatic":0,"state":1,"society":2,"tech":1}},
  {"id":109,"text":"世界各地的人民都有自决权，自由决定他们的政治地位。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-1,"tech":0}},
  {"id":110,"text":"全球变暖是迫在眉睫的威胁。","weights":{"econ":0,"diplomatic":-1,"state":0,"society":-1,"tech":-1}},
  {"id":111,"text":"为了经济增长，可以默许对劳动者权益的一些损害。","weights":{"econ":-2,"diplomatic":0,"state":1,"society":0,"tech":0}},
  {"id":112,"text":"雇佣劳动是资本家对劳动者的剥削和奴役。","weights":{"econ":2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":113,"text":"没有规范限制的市场经济是最好的。","weights":{"econ":-2,"diplomatic":0,"state":-1,"society":0,"tech":0}},
  {"id":114,"text":"女性所受的压迫是剥削形式中最深刻的，且是其他各种压迫的基础。","weights":{"econ":1,"diplomatic":0,"state":-1,"society":-2,"tech":0}},
  {"id":115,"text":"科技进步不应当过快地改变社会。","weights":{"econ":0,"diplomatic":0,"state":0,"society":1,"tech":2}},
  {"id":116,"text":"婚姻制度应当被废除。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":0}},
  {"id":117,"text":"中国正走在正确的道路上，即中国特色社会主义道路。","weights":{"econ":1,"diplomatic":1,"state":1,"society":1,"tech":0}},
  {"id":118,"text":"为了社会的大变革，必须热烈地迎接社会的大崩溃。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":-1}},
  {"id":119,"text":"大麻应当合法化。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":-2,"tech":0}},
  {"id":120,"text":"没有祖国，你什么都不是。","weights":{"econ":0,"diplomatic":2,"state":1,"society":1,"tech":0}},
  {"id":121,"text":"「全世界无产者联合起来」已经过时了。","weights":{"econ":-2,"diplomatic":1,"state":0,"society":0,"tech":0}},
  {"id":122,"text":"若能得到良好的维护，核能将是优良的能量来源。","weights":{"econ":0,"diplomatic":0,"state":0,"society":0,"tech":-1}},
  {"id":123,"text":"人类不应食用或奴役其他动物。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-1,"tech":0}},
  {"id":124,"text":"传统医学比现代医学更值得信任。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":2}},
  {"id":125,"text":"应当大规模应用转基因生物以提高农业产量。","weights":{"econ":0,"diplomatic":0,"state":0,"society":-1,"tech":-2}},
  {"id":126,"text":"族群之间存在天生的智商差异。","weights":{"econ":0,"diplomatic":1,"state":0,"society":2,"tech":0}},
  {"id":127,"text":"毛泽东是近代以来中国最伟大的人。","weights":{"econ":2,"diplomatic":2,"state":2,"society":2,"tech":0}},
  {"id":128,"text":"在我国居住的外国人应当拥有与本国公民同等的权利。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-1,"tech":0}},
  {"id":129,"text":"中小学校应当开设系统的性教育（包括多元性别教育）必修课。","weights":{"econ":0,"diplomatic":0,"state":-1,"society":-2,"tech":0}},
  {"id":130,"text":"太空殖民是解决地球资源枯竭的好办法。","weights":{"econ":-1,"diplomatic":0,"state":0,"society":-1,"tech":-2}},
  {"id":131,"text":"退休年龄应当调低。","weights":{"econ":1,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":132,"text":"应当对进口产品加征关税来保护国内产业。","weights":{"econ":1,"diplomatic":2,"state":0,"society":0,"tech":0}},
  {"id":133,"text":"在一切出现我国地图的场景中，必须使用官方声明的正确国家版图。","weights":{"econ":0,"diplomatic":1,"state":1,"society":1,"tech":0}},
  {"id":134,"text":"社交媒体上充斥着虚假信息和敌对宣传，政府必须直接控制互联网媒体。","weights":{"econ":0,"diplomatic":1,"state":2,"society":1,"tech":2}},
  {"id":135,"text":"作为普通公民，不必关心政治。","weights":{"econ":0,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":136,"text":"因人类行为而造成的物种灭绝是不可接受的。","weights":{"econ":0,"diplomatic":-1,"state":0,"society":-1,"tech":0}},
  {"id":137,"text":"中国人的民族劣根性是真实存在的。","weights":{"econ":0,"diplomatic":-2,"state":0,"society":0,"tech":0}},
  {"id":138,"text":"中国应当像欧洲那样分成一系列小国家。","weights":{"econ":0,"diplomatic":-2,"state":-2,"society":-1,"tech":0}},
  {"id":139,"text":"处于关键时刻的国家需要政治强人。","weights":{"econ":0,"diplomatic":1,"state":2,"society":1,"tech":0}},
  {"id":140,"text":"应当确立最低工资标准以让劳动者有尊严地活着。","weights":{"econ":2,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":141,"text":"做一个好主妇、好母亲，是女人最大的本事。","weights":{"econ":0,"diplomatic":0,"state":0,"society":2,"tech":0}},
  {"id":142,"text":"国家和地区的边界应当被废除。","weights":{"econ":0,"diplomatic":-2,"state":-1,"society":-1,"tech":0}},
  {"id":143,"text":"企业应当关心社会责任，而不只是股东利润。","weights":{"econ":1,"diplomatic":0,"state":0,"society":0,"tech":0}},
  {"id":144,"text":"生命的意义来自超越自我，而不是追求舒适。","weights":{"econ":0,"diplomatic":0,"state":0,"society":1,"tech":0}},
  {"id":145,"text":"应对公共危机时政府也不应当管控信息。","weights":{"econ":0,"diplomatic":0,"state":-2,"society":0,"tech":-1}}
]
